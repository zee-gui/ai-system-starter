{
  "$schema": "https://opencode.ai/config.json",
  "model": "bai/qwen3.8-flash",
  "provider": {
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI (aggregateur, tier gratuit)",
      "options": {
        "baseURL": "https://api.b.ai/v1"
      },
      "models": {
        "qwen3.8-flash": { "name": "Qwen3.8 Flash (gratuit)", "tool_call": true },
        "glm-5.3-flash": { "name": "GLM 5.3 Flash (gratuit)", "tool_call": true },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash", "tool_call": true }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    }
  }
}
